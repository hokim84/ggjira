# Router secrets (never in the config file). `ggjira router setup` prints fresh values for the
# last two.
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=replace-me
GGJIRA_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
GGJIRA_ADMIN_TOKEN=replace-with-at-least-16-random-characters
# Optional (ADR 0027): verifies GitHub pull request webhooks; /webhooks/github is off without it.
# GGJIRA_GITHUB_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
# Optional: read-only token for polling pull requests (public repositories work without one).
# Fine-grained, "Pull requests: Read-only" on the tracked repositories. Also settable in the web UI.
# GITHUB_TOKEN=
# Optional (ADR 0030): Jev shadow assessment. Also settable in the web UI (Settings > Jev 평가).
# TYPESAFE_API_KEY=
LOG_LEVEL=info
