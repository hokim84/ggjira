# Jira Cloud API credentials (secrets — do not commit the real .env)
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# Optional: overrides ggjira.config.json's jira.baseUrl (useful when the
# same config is shared across machines pointed at different Jira sites)
# JIRA_BASE_URL=https://your-domain.atlassian.net
