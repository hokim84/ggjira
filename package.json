{
  "name": "ggjira",
  "version": "0.1.0",
  "description": "Lightweight Jira-based orchestration for human + AI agent work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hokim84/ggjira.git"
  },
  "homepage": "https://github.com/hokim84/ggjira#readme",
  "bugs": "https://github.com/hokim84/ggjira/issues",
  "keywords": ["jira", "ai", "agent", "orchestration", "claude-code", "codex"],
  "type": "module",
  "bin": {
    "ggjira": "./dist/cli.js"
  },
  "files": ["dist", "!dist/**/*.map", "web"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "fastify": "^5.12.5",
    "pino": "^9.5.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.24.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
